#!/data/data/com.termux/files/usr/bin/bash
# Termux Bootstrap Script

# -------------------------------
# Configuration Variables
# -------------------------------

# Packages to install
PACKAGES=(
    git
    neovim
    curl
    wget
    fzf
    python
    eza
    lazygit
    tar
    unzip
    gh
    zoxide
    starship
)

# Dotfiles location
DOTFILES="$HOME/storage/shared/git/droidots"

# Git config defaults
GIT_NAME="HimadriChakra12"
GIT_EMAIL="himadrichakrabortydip@gmail.com"

# -------------------------------
# Functions
# -------------------------------

install_packages() {
    echo "[*] Updating package list..."
    pkg update -y
    echo "[*] Installing packages..."
    for pkg_name in "${PACKAGES[@]}"; do
        echo "Installing $pkg_name..."
        pkg install -y "$pkg_name"
    done
}

setup_git() {
    echo "[*] Configuring Git..."
    gh auth login
    gh auth setup-git
    git config --global user.name "$GIT_NAME"
    git config --global user.email "$GIT_EMAIL"
    # Check for SSH key, generate if missing
    if [[ ! -f "$HOME/.ssh/id_rsa" ]]; then
        echo "[*] Generating SSH key..."
        ssh-keygen -t rsa -b 4096 -f "$HOME/.ssh/id_rsa" -N ""
    fi
    echo "[*] Git setup complete."
}

setup_nvim() {
    echo "[*] Setting up Neovim..."
    git clone https://github.com/himadrichakra12/himastart.nvim ~/.config/nvim
    echo "[*] Neovim configured."
}

setup_shell_aliases() {
    echo "[*] Adding aliases and functions to .bashrc..."
    cat << 'EOF' >> ~/.bashrc
export FZF_COMPLETION_TRIGGER='..'

eval "$(zoxide init bash)"
eval "$(starship init bash)"

if command -v zoxide &> /dev/null; then
  alias cd="zd"
  zd() {
    if [ $# -eq 0 ]; then
      builtin cd ~ && return
    elif [ -d "$1" ]; then
      builtin cd "$1"
    else
      z "$@" && printf "\U000F17A9 " && pwd || echo "Error: Directory not found"
    fi
  }
fi

if command -v eza &> /dev/null; then
  alias ls='eza -lh --group-directories-first --icons=auto'
  alias lsa='ls -a'
  alias lt='eza --tree --level=2 --long --icons --git'
  alias lta='lt -a'
fi

# Directories
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'


DOT="$HOME/storage/shared/git/droidots"
alias dot="cd $DOT"
alias ep="nvim ~/.bashrc"
alias sour="source ~/.bashrc"
alias l="ls"
alias v="nvim"
alias q="exit"
alias c="clear"
alias gg="lazygit"
alias up="pkg update && pkg upgrade"
zo() {
  local selected_item

  selected_item=$(
    ls -a --group-directories-first |
      fzf \
        --layout=reverse \
        --height=90% \
        --header="$(pwd)" \
        --preview '
          if [ -d "{}" ]; then
            eza --color=always -T "{}"
          else
            bat --color=always --style=plain "{}" 2>/dev/null || file "{}"
          fi
        '
  )

  [[ -z "$selected_item" ]] && return

  if [[ -d "$selected_item" ]]; then
    cd "$selected_item" || return
    zo
  else
    xdg-open "$selected_item" >/dev/null 2>&1 &
  fi
}


EOF
    echo "[*] Aliases and functions added."
}

# -------------------------------
# Bootstrap Execution
# -------------------------------

echo "[*] Starting Termux bootstrap..."
install_packages
setup_git
setup_nvim
setup_shell_aliases
echo "[*] Bootstrap complete! Please restart Termux or run 'source ~/.bashrc'."
source ~/.bashrc
